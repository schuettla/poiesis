    {
      "id": "claude-code",
      "kind": "claude-code",
      "name": "Claude Code",
      "binaries": ["claude"],
      "install_url": "https://code.claude.com/docs/en/setup",
      "login_args": ["auth", "login"],
      "status": { "args": ["auth", "status"], "reads": "stdout", "format": "claude-json" },
      "api_key_env": "ANTHROPIC_API_KEY",
      "logo": "claude-code.svg",
      "tested_from": "2.1.301",
      "tested_below": "2.3.0"
    },
    {
